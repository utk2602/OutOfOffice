{
  "name": "outofoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup:local": "tsx scripts/setup.ts",
    "dev": "tsx watch apps/api/src/main.ts",
    "start": "tsx apps/api/src/main.ts",
    "build": "pnpm --filter @outofoffice/api build",
    "start:built": "node apps/api/dist/main.js",
    "agent": "tsx scripts/client.ts",
    "demo": "tsx scripts/demo.ts",
    "eval:agent": "tsx scripts/evaluate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "test:integration": "tsx --test apps/api/test/api.test.ts",
    "test:audio": "tsx --test packages/voice-sdk/test/audio.test.ts packages/voice-sdk/test/speech.test.ts",
    "speech:check": "tsx scripts/speech-check.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "tsup": "8.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
