# Copy with `pnpm setup:local`; it generates a secret in the ignored .env file.
HOST=127.0.0.1
PORT=4000
LOCAL_API_TOKEN=
LOCAL_OWNER_ID=00000000-0000-4000-8000-000000000001
DATA_DIRECTORY=.data
# Unset uses embedded PostgreSQL, with the same SQL schema.
DATABASE_URL=
MAX_MEETING_SECONDS=900
LOCAL_BUDGET_SECONDS=14400
MAX_CONCURRENT_MEETINGS=1
# Hosted Google Meet is opt-in. Tunnel ONLY the callback port, never PORT above.
ENABLE_HOSTED_MEETINGS=false
ATTENDEE_API_KEY=
# Project Settings > Webhooks: base64 signing secret, not the API key.
ATTENDEE_WEBHOOK_SECRET=
PROVIDER_PUBLIC_URL=
PROVIDER_CALLBACK_PORT=4001
# Cumulative hosted seconds, retained across content deletion. Verify trial balance separately.
HOSTED_BUDGET_SECONDS=900
# windows: offline stock speech on Windows; gemini: transcript-verified Live audio.
LIVE_SPEECH_PROVIDER=windows
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
GEMINI_VOICE=Kore
