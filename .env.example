# Copy with `pnpm setup:local`; it generates a secret in the ignored .env file.
HOST=127.0.0.1
PORT=4000
LOCAL_API_TOKEN=
LOCAL_OWNER_ID=00000000-0000-4000-8000-000000000001
DATA_DIRECTORY=.data
# Unset uses embedded PostgreSQL, with the same SQL schema.
DATABASE_URL=
MAX_MEETING_SECONDS=900
LOCAL_BUDGET_SECONDS=14400
MAX_CONCURRENT_MEETINGS=1
# Reserved for a future live provider adapter; not consumed by the local MVP.
# Adding keys alone never enables hosted dispatch or external calls.
ENABLE_GEMINI_LAB=false
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
