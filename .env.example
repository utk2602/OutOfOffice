# Copy with `pnpm setup:local`; it generates a secret in the ignored .env file.
HOST=127.0.0.1
PORT=4000
LOCAL_API_TOKEN=
DATA_DIRECTORY=.data
# Unset uses embedded PostgreSQL, with the same SQL schema.
DATABASE_URL=
MAX_MEETING_SECONDS=900
LOCAL_BUDGET_SECONDS=14400
# No external services are called by default.
ENABLE_GEMINI_LAB=false
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
